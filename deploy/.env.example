# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Generate the password with:  openssl rand -hex 24
# (hex only: it is embedded in a URL, so avoid characters like @ : / %)
POSTGRES_PASSWORD=

QUIZZ_APP_ORIGIN=https://quizz.thangtm.io.vn
QUIZZ_ENVIRONMENT=prod
QUIZZ_COOKIE_SECURE=true

# Local day boundary for the study queue. Optional; this is the default.
QUIZZ_APP_TIMEZONE=Asia/Ho_Chi_Minh

# Which peers uvicorn trusts for X-Forwarded-*. `api` and `worker` now share
# the compose network, so "*" would let any container spoof the client IP used
# by the login lockout. It must name the bridge gateway that nginx connections
# arrive from. Read it from the running stack, then paste the value here:
#   cd deploy
#   docker compose up -d db
#   docker network inspect quizz_default \
#     --format '{{(index .IPAM.Config 0).Gateway}}'
# The network is named `quizz_default` because docker-compose.yml pins
# `name: quizz`. Re-read it after `docker compose down` recreates the network.
FORWARDED_ALLOW_IPS=

# OpenAI-compatible gateway. Only the `worker` container receives these; the
# key is never stored in the database and never reaches the browser.
QUIZZ_LLM_BASE_URL=
QUIZZ_LLM_API_KEY=
QUIZZ_LLM_MODEL=
